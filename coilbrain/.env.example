# ── Runtime ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── Service identity ──────────────────────────────────────
SERVICE_NAME=coilbrain

# ── Persistence ───────────────────────────────────────────
DATABASE_URL=coilbrain.db

# ── Signal Observatory ────────────────────────────────────
# Total observation window per signal
OBS_WINDOW_HOURS=4.0

# Phase 1: T+0 to T+1h — dense polling
OBS_PHASE1_DURATION_S=3600
OBS_PHASE1_INTERVAL_S=30

# Phase 2: T+1h to end of window — sparse polling
OBS_PHASE2_INTERVAL_S=300

# Picker loop wake interval
OBS_PICKER_INTERVAL_S=30

# Binance USDM public endpoints
OBS_BINANCE_EXCHANGE_INFO_URL=https://fapi.binance.com/fapi/v1/exchangeInfo
OBS_BINANCE_PRICE_URL=https://fapi.binance.com/fapi/v1/ticker/price

# HTTP timeout for price fetches (seconds)
OBS_HTTP_TIMEOUT_S=8.0

# ── Bybit Demo / Testnet Credentials ──────────────────────
BYBIT_DEMO_API_KEY=your_bybit_demo_api_key_here
BYBIT_DEMO_API_SECRET=your_bybit_demo_api_secret_here
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com

